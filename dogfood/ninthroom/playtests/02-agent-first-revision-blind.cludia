argument ninth-room "The Ninth Room"
meta profile="workspace", version="0.1.0", cludia-next-ids="v1;P=215;L=75;C=1;CP=9;J=76"

premise[fact] P1:neutral-narration-observable-conditions-this-mystery-reliable ::T "Neutral narration of observable conditions in this mystery is reliable."

premise[fact] P2:statements-attributed-character-are-testimony-unless-independently ::T "Statements attributed to a character are testimony unless independently corroborated."

premise[fact] P3:documents-reliably-contain-words-described-but-their-authors ::T "Documents reliably contain the words described, but their authors and contents may be deceptive."

premise[fact] P4:there-no-secret-passage-mystery ::T "There is no secret passage in the mystery."

premise[fact] P5:there-no-disguised-body-mystery ::T "There is no disguised body in the mystery."

premise[fact] P6:there-no-supernatural-event-mystery ::T "There is no supernatural event in the mystery."

premise[fact] P7:there-no-unintroduced-culprit-mystery ::T "There is no unintroduced culprit in the mystery."

premise[fact] P8:vesper-house-stands-tidal-island-connected-fallowmere-stone ::T "Vesper House stands on a tidal island connected to Fallowmere by a stone causeway only while the tide permits."

premise[fact] P9:fallowmere-station-has-passenger-platforms-parcels-office-telegraph ::T "Fallowmere Station has passenger platforms, a parcels office, a telegraph counter, and a freight yard."

premise[fact] P10:greyhaven-nearest-town-one-railway-stop-inland-fallowmere ::T "Greyhaven is the nearest town and is one railway stop inland from Fallowmere."

premise[fact] P11:miriam-bell-aldous-bell-niece-pharmaceutical-chemist ::T "Miriam Bell is Aldous Bell's niece and a pharmaceutical chemist."

premise[fact] P12:felix-harrow-aldous-bell-private-secretary ::T "Felix Harrow is Aldous Bell's private secretary."

premise[fact] P13:dr-lenora-pike-aldous-bell-physician-oldest-friend ::T "Dr. Lenora Pike is Aldous Bell's physician and oldest friend."

premise[fact] P14:gideon-rusk-solicitor-bell-estate ::T "Gideon Rusk is solicitor to the Bell estate."

premise[fact] P15:cassian-vale-illusionist-whose-apparatus-aldous-collected ::T "Cassian Vale is an illusionist whose apparatus Aldous collected."

premise[fact] P16:beatrice-orr-curator-vesper-collection ::T "Beatrice Orr is curator of the Vesper collection."

premise[fact] P17:constable-merritt-was-vesper-house-before-dinner-return ::T "Constable Merritt was at Vesper House before dinner to return Ruth Dallow's effects and ask Aldous final questions about her death; he was not one of the six guests and the tide prevented him from leaving."

premise[fact] P18:ruth-dallow-was-beatrice-orr-assistant-cataloguer ::T "Ruth Dallow was Beatrice Orr's assistant cataloguer."

premise[fact] P19:ruth-dallow-died-three-nights-earlier-beneath-freight ::T "Ruth Dallow died three nights earlier beneath a freight wagon at Fallowmere Station."

premise[fact] P20:preliminary-finding-concerning-ruth-dallow-death-was-accidental ::T "The preliminary finding concerning Ruth Dallow's death was accidental death."

premise[fact] P21:dinner-aldous-placed-unopened-parcel-beside-his-chair ::T "At dinner, Aldous placed an unopened parcel beside his chair."

premise[fact] P22:aldous-claimed-dinner-that-one-object-his-collection ::T "Aldous claimed at dinner that one object in his collection and one account in his ledger were false, and that someone at the table had killed Ruth Dallow."

premise[fact] P23:aldous-said-that-10-30-he-would-name ::T "Aldous said that at 10:30 he would name the false object, false account, and Ruth Dallow's killer."

premise[fact] P24:statement-9-05-aldous-carried-parcel-upstairs-his ::T "At 9:05, Aldous carried the parcel upstairs to his study, the Ninth Room, whose door bore a brass numeral IX."

premise[fact] P25:statement-9-05-aldous-told-mrs-wren-that ::T "At 9:05, Aldous told Mrs. Wren that no one was to enter until he rang twice."

premise[fact] P26:mrs-wren-watched-aldous-lock-study-door-inside ::T "Mrs. Wren watched Aldous lock the study door from the inside at 9:05."

premise[fact] P27:statement-9-18-study-handbell-rang-once ::T "At 9:18, the study handbell rang once."

premise[fact] P28:mrs-wren-carried-up-hot-water-aldous-normally ::T "Mrs. Wren carried up the hot water Aldous normally requested in the evening."

premise[fact] P29:before-mrs-wren-knocked-9-18-she-heard ::T "Before Mrs. Wren knocked at 9:18, she heard a voice through the study door that she identified as Aldous's; it told her to leave the water and said it would ring twice when ready."

premise[fact] P30:mrs-wren-left-hot-water-tray-corridor-table ::T "Mrs. Wren left the hot-water tray on a corridor table, where it remained untouched."

premise[fact] P31:statement-10-30-aldous-had-not-appeared ::T "At 10:30, Aldous had not appeared."

premise[fact] P32:statement-10-30-study-door-was-still-locked ::T "At 10:30, the study door was still locked and its only key was visible on the inside of the keyhole."

premise[fact] P33:statement-10-30-study-windows-were-latched ::T "At 10:30, the study windows were latched."

premise[fact] P34:statement-10-30-iron-bars-crossed-study-chimney ::T "At 10:30, iron bars crossed the study chimney."

premise[fact] P35:felix-harrow-cassian-vale-broke-down-study-door ::T "Felix Harrow and Cassian Vale broke down the study door."

premise[fact] P36:aldous-was-found-dead-his-desk-his-right ::T "Aldous was found dead at his desk with his right hand pressed against his chest."

premise[fact] P37:there-was-no-obvious-weapon-study ::T "There was no obvious weapon in the study."

premise[fact] P38:tiny-puncture-surrounded-faint-blue-black-stain-was ::T "A tiny puncture surrounded by a faint blue-black stain was present at the fleshy base of Aldous's left thumb."

premise[fact] P39:parcel-was-open-when-aldous-was-found-had ::T "The parcel was open when Aldous was found and had contained a gray vellum book entitled 'A Dissertation Concerning the Tides,' supposedly printed in 1681."

premise[fact] P40:book-brass-clasp-stood-open ::T "The book's brass clasp stood open."

premise[fact] P41:only-book-first-sixteen-leaves-had-been-separated ::T "Only the book's first sixteen leaves had been separated along their folded edges; its remaining leaves were still uncut."

premise[fact] P42:aldous-spectacles-were-folded-inside-their-case ::T "Aldous's spectacles were folded inside their case."

premise[fact] P43:aldous-ivory-paper-knife-remained-sheathed-opposite-side ::T "Aldous's ivory paper knife remained sheathed on the opposite side of the room."

premise[fact] P44:aldous-desk-clock-had-stopped-9-27-its ::T "Aldous's desk clock had stopped at 9:27 and its glass was intact."

premise[fact] P45:desk-clock-winding-key-would-not-turn ::T "The desk clock's winding key would not turn."

premise[fact] P46:fresh-scrape-ran-chair-ordinary-position-toward-desk ::T "A fresh scrape ran from the chair's ordinary position toward the desk."

premise[fact] P47:chair-back-rail-rested-against-desk-directly-beneath ::T "The chair's back rail rested against the desk directly beneath the clock."

premise[fact] P48:burned-paper-fragment-cold-hearth-bore-surviving-text ::T "A burned paper fragment on the cold hearth bore the surviving text 'ROW—17'."

premise[fact] P49:beneath-aldous-right-hand-was-unfinished-sentence-reading ::T "Beneath Aldous's right hand was an unfinished sentence reading, 'The mistake was assuming that Ruth had discovered—'."

premise[fact] P50:no-one-admitted-sending-parcel ::T "No one admitted sending the parcel."

lemma[fact] L1:discovery-every-described-conventional-entry-route-into-study "At discovery, every described conventional entry route into the study was secured, and the mystery rules out a secret passage."
  <- AND#J1(P4, P32, P33, P34)

lemma[fact] L2:aldous-died-after-entering-study-9-05-before "Aldous died after entering the study at 9:05 and before or by the forced entry following 10:30."
  <- AND#J2(P5, P24, P35, P36)

lemma[fact] L3:mrs-wren-9-18-voice-identification-evidence-that "Mrs. Wren's 9:18 voice identification is evidence that Aldous spoke then, but without independent corroboration it is not conclusive proof that he was alive at 9:18."
  <- AND#J3(P2, P29)

lemma[fact] L4:clock-9-27-display-not-yet-reliable-death "The clock's 9:27 display is not yet a reliable death time because the unturnable winding key and freshly repositioned chair beneath the clock create an unexplained mechanical and physical context."
  <- AND#J4(P44, P45, P46, P47)

lemma[fact] L5:parcel-book-clasp-were-opened-sometime-between-parcel "The parcel and the book's clasp were opened sometime between the parcel's appearance unopened at dinner and discovery of the body."
  <- AND#J5(P21, P39, P40)

lemma[fact] L6:parcel-remains-unverified-delivery-its-sender-unresolved-book "The parcel remains an unverified delivery: its sender is unresolved and the book's purported 1681 identity is not established by its described label."
  <- AND#J6(P3, P39, P50)

lemma[fact] L7:if-aldous-dinner-claims-were-substantially-true-preventing "If Aldous's dinner claims were substantially true, preventing his promised 10:30 disclosure is a plausible motive for killing him; the premise remains testimonial."
  <- AND#J7(P2, P22, P23, P36)

premise[fact] P51:dr-pike-examined-aldous-while-other-people-remained ::T "Dr. Pike examined Aldous while the other people remained downstairs."

premise[fact] P52:dr-pike-reported-that-puncture-aldous-thumb-was ::T "Dr. Pike reported that the puncture on Aldous's thumb was recent."

premise[fact] P53:dr-pike-reported-that-blue-black-color-around ::T "Dr. Pike reported that the blue-black color around the puncture was a foreign dye rather than bruising."

premise[fact] P54:dr-pike-reported-that-aldous-posture-pupils-were ::T "Dr. Pike reported that Aldous's posture and pupils were consistent with aconitine poisoning, but that chemical analysis would be required to prove the diagnosis."

premise[fact] P55:aconitine-introduced-through-puncture-might-leave-victim-capable ::T "Aconitine introduced through a puncture might leave a victim capable of speaking for several minutes, with death following ten to thirty minutes later through disruption of the heart."

premise[fact] P56:dr-pike-disclosed-that-aldous-had-long-suffered ::T "Dr. Pike disclosed that Aldous had long suffered from an irregular heartbeat."

premise[fact] P57:dr-pike-stated-that-severe-attack-aldous-irregular ::T "Dr. Pike stated that a severe attack of Aldous's irregular heartbeat could imitate some signs of poisoning but would not explain the puncture or dye."

premise[fact] P58:mrs-wren-reported-that-approximately-6-12-that ::T "Mrs. Wren reported that at approximately 6:12 that evening the study clock showed exactly 6:00."

premise[fact] P59:mrs-wren-reported-that-aldous-told-her-not ::T "Mrs. Wren reported that Aldous told her not to correct the study clock."

premise[fact] P60:if-study-clock-remained-twelve-minutes-slow-its ::T "If the study clock remained twelve minutes slow, its displayed time of 9:27 represented 9:39."

premise[fact] P61:beatrice-explained-that-printed-sheets-were-traditionally-folded ::T "Beatrice explained that printed sheets were traditionally folded into gatherings whose outer folds could remain joined until opened with a paper knife."

premise[fact] P62:beatrice-stated-that-genuinely-uncut-seventeenth-century-copy ::T "Beatrice stated that a genuinely uncut seventeenth-century copy would be valuable because no owner had opened it."

premise[fact] P63:beatrice-stated-that-aldous-ordinarily-inspected-such-book ::T "Beatrice stated that Aldous ordinarily inspected such a book carefully before cutting any additional leaf."

premise[fact] P64:book-first-sixteen-leaves-looked-older-than-block ::T "The book's first sixteen leaves looked older than the block behind them."

premise[fact] P65:book-spine-was-unusually-thick ::T "The book's spine was unusually thick."

premise[fact] P66:parcel-had-surprised-aldous-its-weight ::T "The parcel had surprised Aldous by its weight."

premise[fact] P67:cassian-found-narrow-groove-inside-brass-clasp-stained ::T "Cassian found a narrow groove inside the brass clasp stained with the same blue-black substance found on Aldous's thumb."

premise[fact] P68:groove-inside-clasp-was-too-precisely-machined-be ::T "The groove inside the clasp was too precisely machined to be seventeenth-century work."

premise[fact] P69:something-slender-had-occupied-clasp-groove-but-groove ::T "Something slender had occupied the clasp's groove, but the groove was empty when examined."

premise[fact] P70:when-pressed-shut-book-clasp-resisted-briefly-then ::T "When pressed shut, the book's clasp resisted briefly and then snapped closed with disproportionate force."

premise[fact] P71:cassian-stated-that-clasp-contained-return-spring-that ::T "Cassian stated that the clasp contained a return spring and that something was intended to emerge and then hide itself again."

premise[fact] P72:fallowmere-carrier-delivered-parcel-4-00 ::T "A Fallowmere carrier delivered the parcel at 4:00."

premise[fact] P73:parcel-wrapper-bore-printed-label-march-rowe-antiquarian ::T "The parcel wrapper bore the printed label of March & Rowe, Antiquarian Booksellers."

premise[fact] P74:gideon-stated-that-march-rowe-had-ceased-trading ::T "Gideon stated that March & Rowe had ceased trading five years earlier."

premise[fact] P75:beatrice-stated-that-aldous-had-bought-bundle-march ::T "Beatrice stated that Aldous had bought a bundle of March & Rowe's old labels when its premises were cleared."

premise[fact] P76:beatrice-stated-that-old-march-rowe-labels-were ::T "Beatrice stated that the old March & Rowe labels were stored with packing materials in the Bell estate office at Fallowmere."

premise[fact] P77:beatrice-stated-that-felix-gideon-both-used-bell ::T "Beatrice stated that Felix and Gideon both used the Bell estate office and that she sometimes collected labels there for museum shipments."

premise[fact] P78:felix-had-accepted-parcel-vesper-house ::T "Felix had accepted the parcel at Vesper House."

premise[fact] P79:parcel-contained-no-invoice-sender-address-covering-letter ::T "The parcel contained no invoice, sender's address, or covering letter."

premise[fact] P80:felix-reported-that-while-parcel-was-still-unopened ::T "Felix reported that, while the parcel was still unopened, Aldous weighed it in his hands and said, 'There is something inside this book which the sender does not expect me to read.'"

premise[fact] P81:parcel-was-still-unopened-when-aldous-made-statement ::T "The parcel was still unopened when Aldous made the statement reported by Felix."

lemma[fact] L8:even-if-study-clock-ran-consistently-after-6 "Even if the study clock ran consistently after 6:12, its 9:27 display would correspond to 9:39 rather than 9:27; its abnormal mechanism and nearby chair still prevent treating either time as an established death time."
  <- AND#J8(P44, P45, P58, P60, L4)

lemma[fact] L9:clasp-modern-concealed-mechanism-that-had-held-slender "The clasp is a modern concealed mechanism that had held a slender element and closes with unusual force; Cassian's return-spring explanation fits the observations but remains testimony."
  <- AND#J9(P67, P68, P69, P70, P71)

lemma[fact] L10:matching-blue-black-substance-recent-thumb-puncture-concealed "The matching blue-black substance, recent thumb puncture, and concealed clasp mechanism strongly support, but do not yet prove, that the clasp inflicted Aldous's puncture."
  <- AND#J10(P38, P52, P53, P67, L9)

lemma[fact] L11:aconitine-delivered-through-clasp-puncture-coherent-but-chemically "Aconitine delivered through the clasp puncture is a coherent but chemically unconfirmed explanation of Aldous's death; the diagnosis currently depends in part on Dr. Pike's testimony."
  <- AND#J11(P54, P55, P57, L10)

lemma[fact] L12:book-was-materially-constructed-altered-modern-times-inconsistent "The book was materially constructed or altered in modern times and is inconsistent with an untouched seventeenth-century copy."
  <- AND#J12(P41, P64, P65, P68, L9)

lemma[fact] L13:if-gideon-beatrice-accounts-are-accurate-obsolete-march "If Gideon's and Beatrice's accounts are accurate, the obsolete March & Rowe label could have come from retained stock and does not authenticate the parcel's sender."
  <- AND#J13(P3, P73, P74, P75, P79)

lemma[fact] L14:if-beatrice-office-access-account-accurate-felix-gideon "If Beatrice's office-access account is accurate, Felix, Gideon, and Beatrice each had access to old March & Rowe labels; that shared, non-exclusive access does not establish that any of them sent the parcel."
  <- AND#J14(P2, P75, P76, P77)

lemma[fact] L15:felix-account-partly-corroborated-parcel-unusual-weight-indicates "Felix's account, partly corroborated by the parcel's unusual weight, indicates that Aldous suspected concealed contents before opening it, but the exact statement remains testimony."
  <- AND#J15(P2, P66, P80, P81)

lemma[fact] L16:statement-4-00-carrier-delivery-establishes-when-how "The 4:00 carrier delivery establishes when and how the parcel reached Vesper House but does not identify who prepared or consigned it."
  <- AND#J16(P50, P72, P79)

premise[fact] P82:merritt-reported-that-gideon-cassian-began-playing-billiards ::T "Merritt reported that Gideon and Cassian began playing billiards at approximately 9:10."

premise[fact] P83:felix-entered-billiard-room-9-25-deliver-gideon ::T "Felix entered the billiard room at 9:25 to deliver Gideon a telegram and saw both Gideon and Cassian there."

premise[fact] P84:merritt-sat-hall-opposite-billiard-room-9-25 ::T "Merritt sat in the hall opposite the billiard room from 9:25 until 9:50 while reviewing Ruth's effects."

premise[fact] P85:billiard-room-had-one-door-which-remained-open ::T "The billiard room had one door, which remained open, and Merritt had an uninterrupted view of it from 9:25 until 9:50."

premise[fact] P86:neither-gideon-nor-cassian-left-billiard-room-between ::T "Neither Gideon nor Cassian left the billiard room between 9:25 and 9:50."

premise[fact] P87:mrs-wren-saw-gideon-cassian-inside-billiard-room ::T "Mrs. Wren saw Gideon and Cassian inside the billiard room shortly before 10:00."

premise[fact] P88:gideon-cassian-presence-billiard-room-9-25-through ::T "Gideon's and Cassian's presence in the billiard room from 9:25 through 9:50 is established rather than merely mutually asserted."

premise[fact] P89:miriam-stated-that-she-worked-alone-her-laboratory ::T "Miriam stated that she worked alone in her laboratory from shortly after 9:00 until Dr. Pike joined her at approximately 9:40."

premise[fact] P90:dr-pike-confirmed-that-she-remained-miriam-approximately ::T "Dr. Pike confirmed that she remained with Miriam from approximately 9:40 until shortly after 10:00."

premise[fact] P91:felix-stated-that-apart-delivering-telegram-9-25 ::T "Felix stated that, apart from delivering the telegram at 9:25, he had been typing in the library."

premise[fact] P92:beatrice-stated-that-she-had-been-checking-shelf ::T "Beatrice stated that she had been checking shelf records in the catalogue room."

premise[fact] P93:neither-felix-nor-beatrice-had-continuous-witness-claimed ::T "Neither Felix nor Beatrice had a continuous witness for the claimed activity."

premise[fact] P94:mrs-wren-reported-that-approximately-9-40-while ::T "Mrs. Wren reported that at approximately 9:40, while passing beneath the Ninth Room, she heard a short scraping sound overhead like a chair driven abruptly across the floor."

premise[fact] P95:mrs-wren-reported-hearing-no-cry-approximately-9 ::T "Mrs. Wren reported hearing no cry with the approximately 9:40 scraping sound."

premise[fact] P96:after-inspecting-her-locked-poison-cabinet-miriam-reported ::T "After inspecting her locked poison cabinet, Miriam reported that one sealed ampoule of aconitine was missing."

premise[fact] P97:miriam-inventory-document-recorded-missing-aconitine-ampoule-present ::T "Miriam's inventory document recorded the missing aconitine ampoule as present on September 30."

premise[fact] P98:miriam-current-poison-cabinet-key-remained-her-watch ::T "Miriam's current poison-cabinet key remained on her watch chain."

premise[fact] P99:duplicate-key-miriam-poison-cabinet-had-existed ::T "A duplicate key to Miriam's poison cabinet had existed."

premise[fact] P100:aldous-borrowed-duplicate-poison-cabinet-key-june-inventory ::T "Aldous borrowed the duplicate poison-cabinet key in June for an inventory of hazardous materials."

premise[fact] P101:miriam-reported-that-aldous-later-told-her-duplicate ::T "Miriam reported that Aldous later told her the duplicate poison-cabinet key had been lost."

premise[fact] P102:poison-cabinet-lock-showed-no-damage ::T "The poison-cabinet lock showed no damage."

premise[fact] P103:cassian-described-design-called-self-concealing-thorn-which ::T "Cassian described a design called the Self-Concealing Thorn in which a spring projected a fine needle and immediately withdrew it into an apparently solid fitting."

premise[fact] P104:cassian-stated-that-only-self-concealing-thorn-mechanism ::T "Cassian stated that the only Self-Concealing Thorn mechanism he personally built was dismantled after injuring a stagehand."

premise[fact] P105:plans-self-concealing-thorn-survived-because-they-had ::T "Plans for the Self-Concealing Thorn survived because they had been exhibits in a 1918 patent dispute."

premise[fact] P106:cassian-retained-his-original-self-concealing-thorn-plans ::T "Cassian retained his original Self-Concealing Thorn plans."

premise[fact] P107:aldous-received-reference-copy-self-concealing-thorn-plans ::T "Aldous received a reference copy of the Self-Concealing Thorn plans because he financed the patent case."

premise[fact] P108:gideon-kept-working-copy-self-concealing-thorn-plans ::T "Gideon kept a working copy of the Self-Concealing Thorn plans as solicitor."

premise[fact] P109:felix-catalogued-aldous-litigation-papers-during-previous-winter ::T "Felix catalogued Aldous's litigation papers during the previous winter and handled Aldous's copy of the Self-Concealing Thorn plans."

premise[fact] P110:cassian-aldous-gideon-felix-had-each-possessed-self ::T "Cassian, Aldous, Gideon, and Felix had each possessed the Self-Concealing Thorn plans or had direct access to them."

premise[fact] P111:telegram-felix-delivered-gideon-9-25-contained-words ::T "The telegram Felix delivered to Gideon at 9:25 contained the words, 'RETAINED COPY OF DALLOW MESSAGE LOCATED. SIGNATURE TYPED. WILL BRING AFTER TIDE. —FALLOWMERE STATIONMASTER'."

premise[fact] P112:gideon-stated-that-stationmaster-contacted-him-because-he ::T "Gideon stated that the stationmaster contacted him because he represented the Bell estate."

lemma[fact] L17:if-mrs-wren-9-40-report-accurate-overhead "If Mrs. Wren's 9:40 report is accurate, the overhead scrape probably corresponds to the fresh displacement that left Aldous's chair against the desk."
  <- AND#J17(P46, P47, P94)

lemma[fact] L18:if-mrs-wren-clock-sound-recollections-are-accurate "If Mrs. Wren's clock and sound recollections are accurate and the clock remained twelve minutes slow, the corrected clock stop near 9:39 and the chair scrape near 9:40 probably reflect the same disturbance; this timing remains conditional."
  <- AND#J18(P58, P60, P94, L8, L17)

lemma[fact] L19:if-aconitine-caused-death-approximately-9-40-chair "If aconitine caused the death and the approximately 9:40 chair displacement marked Aldous's fatal collapse, the puncture was probably inflicted between approximately 9:10 and 9:30."
  <- AND#J19(P55, L11, L17)

lemma[fact] L20:if-chair-moved-approximately-9-40-gideon-cassian "If the chair moved at approximately 9:40, Gideon and Cassian could not personally have caused that movement because their billiard-room presence from 9:25 through 9:50 is established."
  <- AND#J20(P88, L17)

lemma[fact] L21:because-unopened-parcel-was-delivered-4-00-aldous "Because the unopened parcel was delivered at 4:00 and Aldous carried it into the locked study himself, its concealed mechanism could have been prepared without the preparer entering the study during the 9:05–10:30 interval."
  <- AND#J21(P21, P24, P72, L9)

lemma[fact] L22:miriam-location-before-approximately-9-40-rests-her "Miriam's location before approximately 9:40 rests on her own account, while Pike's corroboration begins only around 9:40; neither woman's whereabouts before then is independently established by these statements."
  <- AND#J22(P2, P89, P90)

lemma[fact] L23:felix-beatrice-claimed-activities-do-not-provide-either "Felix's and Beatrice's claimed activities do not provide either of them with a continuous corroborated alibi."
  <- AND#J23(P2, P91, P92, P93)

lemma[fact] L24:cabinet-evidence-establishes-only-reported-current-absence-documented "The cabinet evidence establishes only a reported current absence and a documented presence on September 30; it does not establish when the aconitine ampoule disappeared or who removed it."
  <- AND#J24(P3, P96, P97)

lemma[fact] L25:undamaged-cabinet-history-missing-duplicate-key-are-consistent "The undamaged cabinet and history of a missing duplicate key are consistent with removal by key, but do not identify the user; the claim that the duplicate was lost ultimately depends on Miriam's report of Aldous's statement."
  <- AND#J25(P98, P99, P100, P101, P102)

lemma[fact] L26:observed-clasp-mechanism-closely-matches-cassian-described-self "The observed clasp mechanism closely matches Cassian's described Self-Concealing Thorn design, although the design identification remains partly testimonial."
  <- AND#J26(P2, P70, P103, L9)

lemma[fact] L27:knowledge-access-self-concealing-thorn-plans-was-shared "Knowledge of or access to the Self-Concealing Thorn plans was shared by Cassian, Gideon, Felix, and Aldous, so the mechanism does not uniquely implicate Cassian."
  <- AND#J27(P105, P106, P107, P108, P109, P110)

lemma[fact] L28:telegram-reliably-records-claim-that-retained-dallow-message "The telegram reliably records a claim that a retained Dallow message with a typed signature was found, but it does not by itself authenticate that Dallow message or the telegram's purported stationmaster origin."
  <- AND#J28(P3, P111)

premise[fact] P113:ruth-lodged-greyhaven-normally-travelled-one-railway-stop ::T "Ruth lodged in Greyhaven and normally travelled one railway stop to Fallowmere before crossing the causeway to work at Vesper House."

