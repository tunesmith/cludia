argument cludia-discovery "Cludia Discovery"
meta profile="cludia", cludia-next-ids="v1;P=12;L=5;C=1;CP=1;J=5"

premise[fact] P1:current-cludia-reads-expose-grounded-statement-truth-junctor ::T "Current Cludia reads expose grounded statement truth, junctor truth, accepted counterpoint effects, complete rooted structure, and selectable Ledger branches."

premise[fact] P2:current-dogfooding-has-not-yet-produced-grounded-truth ::T "Current dogfooding has not yet produced a grounded truth result that Statement Detail, evaluate, rooted reads, and selected Ledger cannot explain adequately."

premise[value] P3:new-explanation-surface-should-be-justified-concrete-failure ::T "A new explanation surface should be justified by a concrete failure of existing reads rather than by an abstract desire for a shorter proof."

lemma[value] L1:defeat-inclusive-explanation-should-remain-design-investigation-until "Defeat-inclusive explanation should remain a design investigation until dogfooding captures a concrete unexplained result."
  <- AND#J1(P1, P2, P3)

premise[fact] P4:concludia-internal-defeat-registry-can-represent-multiple-explicit ::T "Concludia's internal defeat registry can represent multiple explicit defeat edges originating from one counterpoint."

premise[fact] P5:portable-arg-syntax-gives-each-counterpoint-one-explicit ::T "Portable .arg syntax gives each counterpoint one explicit target, and Cludia must preserve that syntax losslessly."

lemma[value] L2:shared-counterpoint-reuse-requires-coordinated-arg-concludia-format "Shared counterpoint reuse requires a coordinated .arg and Concludia format decision before Cludia implementation."
  <- AND#J2(P4, P5)

premise[fact] P6:top-reorder-tui-only-focused-durable-mutation ::T "Top reorder is the TUI's only focused durable mutation."

premise[fact] P7:top-reorder-already-validates-current-adjacency-saves-atomically ::T "Top reorder already validates current adjacency, saves atomically, and refuses incompatible external changes."

premise[fact] P8:current-dogfooding-has-not-demonstrated-that-bounded-undo ::T "Current dogfooding has not demonstrated that bounded undo is necessary for Top reorder."

lemma[value] L3:bounded-tui-reorder-undo-should-remain-deferred-until "Bounded TUI reorder undo should remain deferred until dogfooding demonstrates a concrete need."
  <- AND#J3(P6, P7, P8)
