#!/usr/bin/env bash

set -euo pipefail

usage() {
  echo "Usage: scripts/release-check vX.Y.Z" >&2
}

fail() {
  echo "release-check: $*" >&2
  exit 1
}

if [[ $# -ne 1 ]]; then
  usage
  exit 2
fi

release_version="$1"
if [[ ! "$release_version" =~ ^v[0-9]+\.[0-9]+\.[0-9]+([.-][0-9A-Za-z.-]+)?$ ]]; then
  fail "version must look like v1.0.0 or v1.1.0-rc.1"
fi

repository_root="$(git rev-parse --show-toplevel 2>/dev/null)" ||
  fail "run this command from a Cludia Git checkout"
cd "$repository_root"

if [[ -n "$(git status --porcelain)" ]]; then
  fail "working tree must be clean"
fi

if git rev-parse --quiet --verify "refs/tags/$release_version" >/dev/null; then
  fail "tag $release_version already exists"
fi

set +e
git ls-remote --exit-code --tags origin "refs/tags/$release_version" >/dev/null 2>&1
remote_tag_status=$?
set -e
case "$remote_tag_status" in
  0) fail "tag $release_version already exists on origin" ;;
  2) ;;
  *) fail "could not check whether tag $release_version exists on origin" ;;
esac

changelog_version="${release_version#v}"
if ! grep -Eq "^## ${changelog_version//./\.} \([0-9]{4}-[0-9]{2}-[0-9]{2}\)$" CHANGELOG.md; then
  fail "CHANGELOG.md needs a dated '## $changelog_version (YYYY-MM-DD)' heading"
fi

[[ -f LICENSE ]] || fail "LICENSE is missing"
grep -Fq "GNU GENERAL PUBLIC LICENSE" LICENSE || fail "LICENSE is not GPLv3 text"
grep -Fq "GPL-3.0-or-later" README.md || fail "README license declaration is missing"

while IFS= read -r source_file; do
  head -n 3 "$source_file" | grep -Fq "SPDX-FileCopyrightText: 2026 KeenWorks" ||
    fail "$source_file is missing the KeenWorks SPDX copyright declaration"
  head -n 3 "$source_file" | grep -Fq "SPDX-License-Identifier: GPL-3.0-or-later" ||
    fail "$source_file is missing the GPL SPDX identifier"
done < <(find cmd internal -type f -name '*.go' -print | LC_ALL=C sort)

if rg -n -i \
  'single-user pre-release|project is pre-release|before (the )?first public release|provisional profile|profile identifier remains provisional|reports its version as `dev`' \
  README.md SPEC.md ROADMAP.md AGENTS.md cludia-suggestions.md cludia-revised-suggestions.md docs; then
  fail "active documentation contains stale release language"
fi

release_tmp_dir="$(mktemp -d "${TMPDIR:-/tmp}/cludia-release-check.XXXXXX")"
trap 'rm -rf "$release_tmp_dir"' EXIT
export GOCACHE="$release_tmp_dir/go-cache"

echo "==> Checking whitespace"
git diff --check HEAD^ HEAD

echo "==> Running tests"
go test -count=1 ./...

echo "==> Running race tests"
go test -race ./...

echo "==> Running vet"
go vet ./...

echo "==> Building commands"
go build ./cmd/...

echo "==> Verifying checked-in and linker-injected versions"
go build -o "$release_tmp_dir/cludia-default" ./cmd/cludia
go build -ldflags "-X main.version=$release_version" -o "$release_tmp_dir/cludia-injected" ./cmd/cludia
expected_version="cludia $release_version"
[[ "$("$release_tmp_dir/cludia-default" --version)" == "$expected_version" ]] ||
  fail "checked-in version does not report '$expected_version'"
[[ "$("$release_tmp_dir/cludia-default" version)" == "$expected_version" ]] ||
  fail "version command does not report '$expected_version'"
[[ "$("$release_tmp_dir/cludia-injected" --version)" == "$expected_version" ]] ||
  fail "injected version does not report '$expected_version'"

echo "==> Running compatibility and process contracts"
go test -count=1 ./internal/argfile \
  -run 'TestWorkspaceExampleParsesAndSemanticallyRoundTrips|TestConcludiaConstructsRoundTrip|TestCurrentConcludiaFixtureParsesValidatesAndRoundTrips|TestSaveAtomicSerializationFailureLeavesExistingFileUntouched'
go test -count=1 ./internal/validation \
  -run 'TestExamplesValidateUnderExpectedProfiles|TestConcludiaProfileAcceptsORDirectSupportAndDefeats|TestDirectedSupportCycleIsRejected'
go test -count=1 ./internal/evaluation
go test -count=1 ./cmd/cludia \
  -run 'TestCLIProcessContract|TestLegacyWorkspaceProfileReadDryRunFailureAndSaveMigration|TestAddBatchV2AuthorsStatementsRelationsAndDefeatsAtomically|TestRootJSONReturnsCompleteExportableClosure|TestExportWritesNewStrictArtifactWithoutChangingWorkspace|TestNormalizeTruthPlanApplyAndLeafOnlyEditing'

echo "==> Validating tracked Cludia workspaces"
"$release_tmp_dir/cludia-default" validate --profile cludia examples/broken-window-workspace.arg >/dev/null
"$release_tmp_dir/cludia-default" validate --profile cludia dogfood/cludia-discovery.arg >/dev/null
while IFS= read -r playtest; do
  "$release_tmp_dir/cludia-default" validate --profile cludia "$playtest" >/dev/null
done < <(find dogfood/ninthroom/playtests -type f -name '*.arg' -print | LC_ALL=C sort)

echo "release-check: $release_version passed"
